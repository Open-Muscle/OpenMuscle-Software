# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl

# Your recordings are private. OpenMuscle keeps them in ~/OpenMuscle (outside
# this repository); these rules cover the same files if --data-dir, OPENMUSCLE_HOME
# or --captures-dir points somewhere inside a clone, so `git status` stays clean
# and a recording cannot be committed by accident. Anchored to the repo root so
# the pc/src/openmuscle/data Python package is not affected.
/OpenMuscle/
/data/captures/
/data/sessions/
/data/models/
/data/exports/
/data/logs/
/data/raw/sessions/
/data/raw/merged/
/pc/data/*
!/pc/data/README.md
# Sidecar files written next to every take, wherever the folder is.
*.sensor.jsonl
*.label.jsonl
*.meta.json
*.labels.schema.json
# Trained models (large binary files; pickles are not safe to share).
*.pkl

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# MicroPython
settings.json

# Virtual environments
.venv/
venv/
env/

# Local TLS material for the VR /vr page (mkcert-generated, per-machine).
# vr-key.pem is a PRIVATE KEY and the mkcert rootCA-key is the CA private key --
# NEVER commit these. Broad cert/key globs so nothing slips in regardless of
# name or format. Per-machine certs are also kept in ~/.openmuscle/ (outside the
# repo); openmuscle web auto-loads from there.
*.pem
*.key
*.crt
*.pfx
*.p12
*.cer
rootCA*.pem

# Offline hand-tracker / three.js copies are downloaded by `openmuscle assets fetch`
# into ~/OpenMuscle/assets; never commit the binaries if a copy lands in the tree.
pc/src/openmuscle/web/static/vendor/
hand_landmarker.task
